ociété par actions simplifiée unipersonnelle (SASU)\\nCapital social : 10 000 EUR\\n\\nDate d'immatriculation : 15/01/2024\\n\\nDirigeant : M. Pierre MARTIN, Président\\n\\nAdresse du siège social : 15 rue des Lilas, 69003 Lyon\\n\\nActivité : Développement de solutions numériques et conseil en technologies de\\nl'information\\n\\nCode APE : 6202A\\n\"],\"options\":{\"lc\":1,\"type\":\"not_implemented\",\"id\":[\"langchain\",\"chat_models\",\"ollama\",\"ChatOllama\"]},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\n  \\\"id\\\": \\\"CLI-MREZWABN-1LRS\\\",\\n  \\\"nom_societe\\\": \\\"Erreur\\\",\\n  \\\"email_expediteur\\\": \\\"mehdi.ben.salah@skillia.fr\\\",\\n  \\\"email_client\\\": \\\"marion@marthe-studio.com\\\",\\n  \\\"siret\\\": \\\"85236974100012\\\",\\n  \\\"parcours\\\": \\\"creation\\\",\\n  \\\"paie\\\": true,\\n  \\\"juridique\\\": true,\\n  \\\"honoraires_comptabilite_annuel\\\": \\\"2520\\\",\\n  \\\"tarif_bulletin_paie\\\": \\\"27\\\",\\n  \\\"honoraires_juridique\\\": \\\"650\\\",\\n  \\\"capital_social\\\": \\\"Erreur\\\",\\n  \\\"nom_client\\\": \\\"Marion Rousset\\\",\\n  \\\"tel_client\\\": \\\"Non renseigné\\\",\\n  \\\"nom_associé\\\": \\\"Zied El Arbi\\\",\\n  \\\"email_associé\\\": \\\"z.elarbi@coleadfinance.com\\\",\\n  \\\"tel_associé\\\": \\\"+33 6 58 45 54 48\\\"\\n}\"}]]},\"tokenUsageEstimate\":{\"completionTokens\":219,\"promptTokens\":12852,\"totalTokens\":13071}}}"}}
