    {
      "parameters": {
        "jsCode": "const output = [];\n\nfunction decodeBody(data) {\n  if (!data) return '';\n  const b64 = data.replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(b64, 'base64').toString('utf-8');\n}\n\n// Recursively walk the payload/parts tree and collect text/plain + text/html\n// wherever they appear, at any depth.\nfunction extractBodies(part, result) {\n  if (!part) return;\n\n  if (part.mimeType === 'text/plain' && part.body && part.body.data) {\n    result.textPlain += decodeBody(part.body.data);\n  }\n  if (part.mimeType === 'text/html' && part.body && part.body.data) {\n    result.textHtml += decodeBody(part.body.data);\n  }\n\n  // Some messages have body.data directly on a part with no mimeType match above\n  // but with nested parts (multipart/*) — recurse into them.\n  if (Array.isArray(part.parts)) {\n    for (const sub of part.parts) {\n      extractBodies(sub, result);\n    }\n  }\n}\n\nfor (const item of items) {\n  let data = item.json;\n  if (Array.isArray(data)) {\n    data = data[0];\n  }\n\n  const messages = data.messages || (data.value && data.value.messages) || [];\n\n  if (!Array.isArray(messages)) {\n    output.push({ json: { error: 'No messages array found', raw: data } });\n    continue;\n  }\n\n  for (const msg of messages) {\n    const result = { textPlain: '', textHtml: '' };\n\n    // Handle simple (non-multipart) messages where body.data sits directly on payload\n    if (msg.payload && msg.payload.body && msg.payload.body.data && !msg.payload.parts) {\n      extractBodies(msg.payload, result);\n    } else if (msg.payload) {\n      extractBodies(msg.payload, result);\n    }\n\n    output.push({\n      json: {\n        messageId: msg.id,\n        threadId: msg.threadId,\n        snippet: msg.snippet,\n        textPlain: result.textPlain,\n        textHtml: result.textHtml,\n      }\n    });\n  }\n}\n\nreturn output;"
      },
