    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// JS - Détecteur Doublon\n// ─────────────────────────────────────────────\nconst rawOutput = $('Call Extraction des données + PJ').first().json.output_firstItem;\nlet cleanOutput = rawOutput;\nif (typeof rawOutput === 'string') {\n  cleanOutput = rawOutput.replace(/```json\\s*|```/g, '').trim();\n}\nconst newItem = typeof cleanOutput === 'string' ? JSON.parse(cleanOutput) : cleanOutput;\n\nconst INVALID_VALUES = ['Erreur', 'Non renseigné', ''];\n\nconst existingClients = $('Lire Clients Sheet').all();\nlet matchedRow = null;\nlet matchReason = null;\nfor (const client of existingClients) {\n  const row = client.json;\n  if (row.siret && newItem.siret &&\n      !INVALID_VALUES.includes(row.siret) && !INVALID_VALUES.includes(newItem.siret) &&\n      String(row.siret).trim() === String(newItem.siret).trim()) {\n    matchedRow = client;\n    matchReason = 'siret';\n    break;\n  }\n  if (row.email_client && newItem.email_client &&\n      !INVALID_VALUES.includes(row.email_client) && !INVALID_VALUES.includes(newItem.email_client) &&\n      row.email_client.toLowerCase().trim() === newItem.email_client.toLowerCase().trim()) {\n    matchedRow = client;\n    matchReason = 'email_client';\n    break;\n  }\n  if (row.nom_société && newItem.nom_societe &&\n      row.nom_société.toLowerCase().trim() === newItem.nom_societe.toLowerCase().trim()) {\n    matchedRow = client;\n    matchReason = 'nom_société';\n    break;\n  }\n}\n\nconst fieldsToCompare = ['nom_société', 'email_client', 'siret', 'parcours', 'paie', 'juridique'];\nconst differences = [];\nconst finalItem = { ...newItem };\n\nif (matchedRow) {\n  const oldData = matchedRow.json;\n  for (const field of fieldsToCompare) {\n    const oldVal = String(oldData[field] ?? '').trim();\n    const newFieldKey = field === 'nom_société' ? 'nom_societe' : field;\n    const newVal = String(newItem[newFieldKey] ?? '').trim();\n\n    if (oldVal === 'Erreur' && newVal !== '' && newVal !== 'undefined' && newVal !== 'Erreur') {\n      differences.push({ field, ancien: oldVal, nouveau: newVal, raison: 'correction_erreur' });\n      continue;\n    }\n    if (newVal === 'Erreur' && oldVal !== '' && oldVal !== 'Erreur') {\n      finalItem[newFieldKey] = oldVal;\n      continue;\n    }\n    if (oldVal !== newVal && newVal !== '' && newVal !== 'undefined') {\n      differences.push({ field, ancien: oldVal, nouveau: newVal });\n    }\n  }\n}\n\nreturn [{\n  json: {\n    ...finalItem,\n    isDuplicate: !!matchedRow,\n    matchReason: matchReason,\n    existingRowNumber: matchedRow ? matchedRow.json.row_number : null,\n    existingRowData: matchedRow ? matchedRow.json : null,\n    differences: differences\n  }\n}];"
      },
