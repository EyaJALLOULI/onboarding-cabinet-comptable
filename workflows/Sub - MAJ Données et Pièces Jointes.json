    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Node: JS-Fusionner Champs Vides\n// Mode : Run Once for All Items\n// Règle : \n//   - Complète les champs vides/FALSE avec les nouvelles valeurs\n//   - Met à jour les champs qui ont changé (differences détectées par JS-Détecter Doublon)\n\nconst detected = $('Start').first().json._firstItem;\nconst oldData = detected.existingRowData || {};\nconst differences = detected.differences || [];\n\nfunction isEmptyValue(v) {\n  if (v === undefined || v === null) return true;\n  const s = String(v).trim().toUpperCase();\n  return s === '' || s === 'FALSE' || s === 'NON RENSEIGNÉ';\n}\n\nconst fieldsToMerge = ['nom_société', 'email_client', 'siret', 'parcours', 'paie', 'juridique'];\nconst merged = { ...oldData };\nconst changedFields = [];\n\n// Construire un dictionnaire des champs qui ont changé\nconst diffMap = {};\nfor (const diff of differences) {\n  diffMap[diff.field] = diff.nouveau;\n}\n\nfor (const field of fieldsToMerge) {\n  const oldVal = oldData[field];\n  const newVal = detected[field] !== undefined\n    ? detected[field]\n    : detected[field.replace('é', 'e').replace('è', 'e')];\n\n  // Cas 1 : champ vide/FALSE → compléter avec la nouvelle valeur\n  if (isEmptyValue(oldVal) && !isEmptyValue(newVal)) {\n    merged[field] = newVal;\n    changedFields.push(field);\n  }\n  // Cas 2 : champ différent détecté par differences → remplacer par la nouvelle valeur\n  else if (diffMap[field] !== undefined) {\n    merged[field] = diffMap[field];\n    changedFields.push(field);\n  }\n}\n\nreturn {\n  json: {\n    ...merged,\n    existingRowNumber: detected.existingRowNumber,\n    changedFields,\n    hasChanges: changedFields.length > 0\n  }\n};"
      },
