    {
      "parameters": {
        "jsCode": "const folderId = $json.id;\nconst rawData = $('Start').first().json.JSDdupliquer__allItems;\n\nlet parsed;\nif (typeof rawData === 'string') {\n  parsed = JSON.parse(rawData);\n} else if (Array.isArray(rawData)) {\n  parsed = rawData;\n} else {\n  parsed = [];\n}\n\nconst fichiers = parsed.map(item => item.json);\n\nreturn fichiers.map(f => ({\n  json: {\n    folderId,\n    filename: f.filename,\n    messageId: f.messageId,\n    attachmentId: f.attachmentId\n  }\n}));"
      },
