    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originaux = $('If there is an attachment').all();\nconst results = [];\n\nlet nomSociete = 'Societe';\ntry {\n  const agentOutput = $('Start').first().json.output_firstItem;\n  const parsed = typeof agentOutput === 'string' ? JSON.parse(agentOutput) : agentOutput;\n  nomSociete = (parsed?.nom_societe || 'Societe').replace(/\\s+/g, '');\n} catch (e) {\n  nomSociete = 'Societe';\n}\n\nconst today = new Date().toISOString().split('T')[0];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const orig = originaux[i]?.json || {};\n\n  let gmailResponse;\n  if (item.binary && item.binary.data) {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    gmailResponse = JSON.parse(buffer.toString('utf-8'));\n  } else {\n    gmailResponse = item.json;\n  }\n\n  if (!gmailResponse || !gmailResponse.data) {\n    results.push({ json: { ...item.json, statut: 'erreur_pas_de_data' } });\n    continue;\n  }\n\n  const base64Standard = gmailResponse.data.replace(/-/g, '+').replace(/_/g, '/');\n  const pdfBuffer = Buffer.from(base64Standard, 'base64');\n\n  const nomOriginal = orig.filename || `document${i + 1}.pdf`;\n  const extension = nomOriginal.includes('.') ? nomOriginal.split('.').pop() : 'pdf';\n  const typeDoc = nomOriginal.includes('.') ? nomOriginal.substring(0, nomOriginal.lastIndexOf('.')) : nomOriginal;\n  const mimeType = orig.mimeType || 'application/pdf';\n\n  const nouveauNom = `${today}_${nomSociete}_${typeDoc}.${extension}`;\n\n  results.push({\n    json: { ...item.json, filename: nouveauNom },\n    binary: {\n      data: await this.helpers.prepareBinaryData(pdfBuffer, nouveauNom, mimeType)\n    }\n  });\n}\n\nreturn results;"
      },
