    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nlet nomSociete = 'Societe';\ntry {\n  const agentOutput = $('Start').first().json.output_firstItem;\n  const parsed = typeof agentOutput === 'string' ? JSON.parse(agentOutput) : agentOutput;\n  nomSociete = (parsed?.nom_societe || 'Societe').replace(/\\s+/g, '');\n} catch (e) {\n  nomSociete = 'Societe';\n}\n\nconst today = new Date().toISOString().split('T')[0];\n\nfor (const item of items) {\n  const buffer = await this.helpers.getBinaryDataBuffer(items.indexOf(item), 'data');\n  const gmailResponse = JSON.parse(buffer.toString('utf-8'));\n  \n  const base64Standard = gmailResponse.data.replace(/-/g, '+').replace(/_/g, '/');\n  const pdfBuffer = Buffer.from(base64Standard, 'base64');\n  \n  const nomActuel = item.json.filename || 'document.pdf';\n  const extension = nomActuel.includes('.') ? nomActuel.split('.').pop() : 'pdf';\n  const typeDoc = nomActuel.includes('.') ? nomActuel.substring(0, nomActuel.lastIndexOf('.')) : nomActuel;\n  \n  const nouveauNom = `${today}_${nomSociete}_${typeDoc}.${extension}`;\n\n  results.push({\n    json: { ...item.json, filename: nouveauNom },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        pdfBuffer,\n        nouveauNom,\n        item.json.mimeType || 'application/pdf'\n      )\n    }\n  });\n}\n\nreturn results;"
      },
