    {
      "parameters": {
        "jsCode": "// Node: JS-Filtrer Nouveaux Fichiers\n// Mode : Run Once for All Items\n// Le hash Gmail est maintenant calculé sur le PDF décodé = identique au md5Checksum Drive\n\n// ---------- MD5 des fichiers existants dans Drive ----------\nconst driveResponse = $('HTTP Request1').first().json;\nconst existingFiles = driveResponse.files || [];\nconst existingMD5s = new Set(existingFiles.map(f => f.md5Checksum).filter(Boolean));\n\n// ---------- Nouveaux fichiers depuis JS-Dédupliquer ----------\nlet rawNewFiles = $('Start').first().json.JSDdupliquer__allItems || [];\nif (typeof rawNewFiles === 'string') {\n  try { rawNewFiles = JSON.parse(rawNewFiles); } catch (e) {\n    return [{ json: { hasNewFiles: false, count: 0, error: 'Parse JSON échoué: ' + e.message } }];\n  }\n}\nconst newFiles = (Array.isArray(rawNewFiles) ? rawNewFiles : []).map(item => ({ json: item?.json ?? item }));\n\n// ---------- Déduplication ----------\nconst seenHashes = new Set();\nconst uniqueNewFiles = [];\n\nfor (const item of newFiles) {\n  const f = item.json;\n  const hash = f.hash; // MD5 du PDF décodé = même que Drive\n\n  if (!hash) continue;\n\n  // Doublon parmi les nouveaux ?\n  if (seenHashes.has(hash)) continue;\n  seenHashes.add(hash);\n\n  // Déjà présent dans Drive ?\n  if (existingMD5s.has(hash)) continue;\n\n  uniqueNewFiles.push({ json: { ...f, hasNewFiles: true } });\n}\n\n// ---------- Sortie ----------\nif (uniqueNewFiles.length === 0) {\n  return [{ json: { hasNewFiles: false, count: 0 } }];\n}\n\nreturn uniqueNewFiles;"
      },
